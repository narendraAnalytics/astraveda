{
  "expo": {
    "name": "AstraVeda",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astraveda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.astraveda.app"
    },
    "android": {
      "package": "com.astraveda.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffaf2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      "@clerk/expo",
      "@clerk/expo-google-signin",
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "AstraVeda uses the camera for palmistry, face reading and Vastu scans.",
          "microphonePermission": "AstraVeda uses the microphone for voice guidance in Ask AstraVeda.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AstraVeda needs access to your photos so you can upload palm and face images for readings."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AstraVeda uses your location to detect your birth place and align Vastu directions."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AstraVeda uses the microphone so you can speak your questions in Ask AstraVeda."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8f29dd"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d53f4651-a0d3-44ac-a53a-cc4134adcc90"
      },
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "431460312514-63s4qekjv0m8bc5n6alj0ainbpa8hsl8.apps.googleusercontent.com"
    },
    "owner": "saasaideveloper",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d53f4651-a0d3-44ac-a53a-cc4134adcc90"
    }
  }
}
