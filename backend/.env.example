# AstraVeda backend — copy to .env and fill in

# Sarvam AI — https://dashboard.sarvam.ai -> API Keys
SARVAM_API_KEY=
# Chat model for the Kundali reading (translate model is separate, see config.py)
SARVAM_CHAT_MODEL=sarvam-105b
# Reasoning for the reading model: blank = off (cheapest), or low|medium|high
SARVAM_REASONING_EFFORT=

# Neon Postgres pooled connection string (leave blank to use a local SQLite file)
DATABASE_URL=

# CORS: comma-separated allowed origins, or * for all
ALLOWED_ORIGINS=*

# Clerk dashboard -> API Keys -> Show JWT public key (PEM)
CLERK_JWT_KEY=
CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev
# Clerk dashboard -> Webhooks -> endpoint -> Signing Secret (whsec_...)
CLERK_WEBHOOK_SECRET=
